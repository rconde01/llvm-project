{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Ninja - Debug",
      "description": "Configure with Ninja in ./build/debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FLANG_ENABLE_WERROR": "ON",
        "LLVM_ENABLE_ASSERTIONS": "ON",
        "LLVM_TARGETS_TO_BUILD":"host",
        "LLVM_LIT_ARGS":"-v",
        "LLVM_ENABLE_PROJECTS":"clang;mlir;flang",
        "LLVM_ENABLE_RUNTIMES":"compiler-rt;flang-rt;openmp"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja - Release",
      "description": "Configure with Ninja in ./build/release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FLANG_ENABLE_WERROR": "ON",
        "LLVM_ENABLE_ASSERTIONS": "ON",
        "LLVM_TARGETS_TO_BUILD":"host",
        "LLVM_LIT_ARGS":"-v",
        "LLVM_ENABLE_PROJECTS":"clang;mlir;flang",
        "LLVM_ENABLE_RUNTIMES":"compiler-rt;flang-rt;openmp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug"
    },
    {
      "name": "build-release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
